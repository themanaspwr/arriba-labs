}

.author-name {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  color: #ffffff;
  font-style: normal;
  display: block;
}

.author-role {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* --------------------------------------------------------------------------
   11. STRATEGY CALL DISPATCH & FORM SECTION
   -------------------------------------------------------------------------- */
.contact-card-wrapper {
  position: relative;
  background: linear-gradient(145deg, rgba(16, 24, 46, 0.8) 0%, rgba(9, 14, 28, 0.92) 100%);
  border: 1px solid var(--border-glow);
