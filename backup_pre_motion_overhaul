}

/* --------------------------------------------------------------------------
   9. 4-STAGE GROWTH FRAMEWORK
   -------------------------------------------------------------------------- */
.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  position: relative;
}

.process-step {
  background: var(--bg-glass-card);
