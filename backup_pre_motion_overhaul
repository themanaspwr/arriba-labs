  border-radius: var(--radius-lg);
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s var(--ease-spring), border-color 0.3s;
}

.process-step:hover {
  transform: translateY(-6px);
  border-color: var(--border-bright);
}

.step-marker {
