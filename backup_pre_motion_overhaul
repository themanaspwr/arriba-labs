/* ==========================================================================
   ARRIBA LABS — BOLD CREATIVE PERFORMANCE & E-COMMERCE GROWTH
   Bespoke Vanilla CSS • Luxury Kinetic Aesthetic • Highly Responsive
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. DESIGN SYSTEM & COLOR TOKENS (DIRECTLY FROM ARRIBA LOGO CHEVRON)
   -------------------------------------------------------------------------- */
:root {
  /* Brand Chevron Spectrum */
  --c-plum: #602d50;
  --c-purple: #5f3d83;
  --c-indigo: #534a97;
  --c-cobalt: #475fa7;
  --c-sky: #548fcb;
  --c-ice: #e8f0fe;

  /* Ambient Midnight Obsidian Foundations */
  --bg-deep: #060911;
  --bg-surface: #0a0f1d;
  --bg-glass: rgba(13, 20, 36, 0.72);
  --bg-glass-strong: rgba(16, 25, 46, 0.88);
  --bg-glass-card: rgba(18, 28, 51, 0.55);
  --bg-glass-hover: rgba(26, 40, 71, 0.75);
  --bg-input: rgba(9, 14, 25, 0.85);

  /* Borders & Glare */
  --border-subtle: rgba(84, 143, 203, 0.18);
  --border-glow: rgba(84, 143, 203, 0.45);
  --border-bright: #548fcb;
  --border-card: rgba(255, 255, 255, 0.08);

  /* Typography Colors */
  --text-main: #ffffff;
  --text-secondary: #c9d7ec;
  --text-muted: #7d93b3;
  --text-dim: #4d5e75;

  /* Fonts */
  --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* Geometry & Grid */
  --container-width: 1320px;
  --header-height: 84px;
  --radius-xs: 6px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-full: 9999px;

  /* Shadows & Illuminations */
  --shadow-ambient: 0 20px 50px rgba(0, 0, 0, 0.6);
  --shadow-glow: 0 0 40px rgba(84, 143, 203, 0.28);
  --shadow-plum-glow: 0 0 50px rgba(96, 45, 80, 0.35);

  /* Transitions */
  --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-smooth: cubic-bezier(0.25, 1, 0.5, 1);
}

/* --------------------------------------------------------------------------
   2. RESET & FOUNDATIONS
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-family: var(--font-body);
  background-color: var(--bg-deep);
  color: var(--text-main);
  font-size: 16px;
  line-height: 1.6;
  scroll-behavior: smooth;
  scroll-padding-top: var(--header-height);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  position: relative;
  overflow-x: hidden;
  min-height: 100vh;
  background-color: var(--bg-deep);
  color: var(--text-main);
}

::selection {
  background: var(--c-purple);
  color: #ffffff;
}

/* Interactive Ambient Canvas (Fixed Background) */
.ambient-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  opacity: 0.55;
}

/* Grain Film Texture */
.noise-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

/* Custom Magnetic Liquid Cursor */
.custom-cursor {
  position: fixed;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 9999;
  display: none;
}

@media (pointer: fine) {
  .custom-cursor {
    display: block;
  }
}

.cursor-dot {
  position: absolute;
  top: -4px;
  left: -4px;
  width: 8px;
  height: 8px;
  background: #ffffff;
  border-radius: 50%;
  transform: translate3d(0, 0, 0);
  transition: transform 0.05s linear;
  box-shadow: 0 0 10px #ffffff, 0 0 20px var(--c-sky);
}

.cursor-ring {
  position: absolute;
  top: -24px;
  left: -24px;
  width: 48px;
  height: 48px;
  border: 1.5px solid rgba(84, 143, 203, 0.4);
  border-radius: 50%;
  transform: translate3d(0, 0, 0);
  transition: width 0.3s var(--ease-spring), height 0.3s var(--ease-spring), top 0.3s var(--ease-spring), left 0.3s var(--ease-spring), border-color 0.3s, background 0.3s;
}

.custom-cursor.hovering .cursor-ring {
  top: -36px;
  left: -36px;
  width: 72px;
  height: 72px;
  border-color: var(--c-sky);
  background: rgba(84, 143, 203, 0.12);
  backdrop-filter: invert(0.08);
}

/* Layout Containers */
.container {
  width: 100%;
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 2;
}

.section-padding {
  padding: 72px 0;
}

@media (max-width: 768px) {
  .section-padding {
    padding: 48px 0;
  }
}

/* Gradient Typography & Accents */
.gradient-text {
  background: linear-gradient(135deg, #ffffff 0%, var(--c-sky) 50%, #9bc2e8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 28px;
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  border-radius: var(--radius-full);
  border: none;
  cursor: pointer;
  transition: all 0.35s var(--ease-spring);
  position: relative;
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, var(--c-plum) 0%, var(--c-purple) 35%, var(--c-indigo) 70%, var(--c-sky) 100%);
  background-repeat: no-repeat;
  color: #ffffff;
  box-shadow: 0 8px 25px rgba(95, 61, 131, 0.45);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 35px rgba(84, 143, 203, 0.55);
  filter: brightness(1.12);
  color: #ffffff;
}

.btn-glass {
  background: var(--bg-glass);
  color: #ffffff;
  border: 1px solid var(--border-subtle);
  backdrop-filter: blur(12px);
}

.btn-glass:hover {
  background: var(--bg-glass-hover);
  border-color: var(--border-bright);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(84, 143, 203, 0.25);
}

.btn-nav-cta {
  background: linear-gradient(135deg, var(--c-purple), var(--c-cobalt), var(--c-sky));
  color: #ffffff;
  padding: 10px 22px;
  font-size: 0.88rem;
  font-weight: 600;
  box-shadow: 0 4px 18px rgba(84, 143, 203, 0.3);
}

.btn-nav-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(84, 143, 203, 0.5);
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.btn-lg {
  padding: 16px 32px;
  font-size: 1.05rem;
}

.btn-arrow-icon {
  width: 16px;
  height: 16px;
  transition: transform 0.3s var(--ease-spring);
}

.btn:hover .btn-arrow-icon {
  transform: translateX(4px);
}

.btn-sparkle-icon {
  width: 16px;
  height: 16px;
  fill: var(--c-sky);
}

/* --------------------------------------------------------------------------
   3. SITE HEADER & GLASS COCKPIT NAV
   -------------------------------------------------------------------------- */
.site-header {
  position: fixed;
  top: 16px;
  left: 0;
  width: 100%;
  z-index: 1000;
  transition: top 0.3s;
}

.nav-container {
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 10px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(10, 15, 29, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-full);
  box-shadow: 0 10px 35px rgba(0, 0, 0, 0.4);
}

.brand-link {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.brand-logo-img {
  height: 40px;
  width: auto;
  display: block;
  object-fit: contain;
  transition: transform 0.3s var(--ease-spring);
}

.brand-link:hover .brand-logo-img {
  transform: scale(1.03);
}

.nav-center-menu {
  display: flex;
  align-items: center;
}

.nav-links {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 8px;
}

.nav-link {
  padding: 8px 16px;
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.92rem;
  font-weight: 500;
  border-radius: var(--radius-full);
  transition: all 0.25s var(--ease-smooth);
}

.nav-link:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Sound Interaction Toggle */
.sound-toggle-btn {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  font-size: 0.8rem;
  font-family: var(--font-body);
  font-weight: 500;
  cursor: pointer;
  transition: all 0.25s;
}

.sound-toggle-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border-color: var(--border-bright);
}

.sound-toggle-btn.active {
  background: rgba(84, 143, 203, 0.15);
  border-color: var(--border-bright);
  color: var(--c-sky);
}

.sound-icon {
  display: flex;
  align-items: center;
}

.hidden {
  display: none !important;
}

/* Mobile Menu Toggle */
.mobile-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 40px;
  height: 40px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border-subtle);
  border-radius: 50%;
  cursor: pointer;
  padding: 10px;
}

.hamburger-bar {
  display: block;
  width: 18px;
  height: 2px;
  background: #ffffff;
  border-radius: 2px;
  transition: transform 0.3s, opacity 0.3s;
}

/* Mobile Drawer */
.mobile-drawer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(6, 9, 17, 0.95);
  backdrop-filter: blur(24px);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40px 24px;
  transform: translateY(-100%);
  transition: transform 0.4s var(--ease-spring);
  pointer-events: none;
}

.mobile-drawer.open {
  transform: translateY(0);
  pointer-events: auto;
}

.mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 20px;
  text-align: center;
  margin-bottom: 40px;
}

.mobile-nav-link {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 700;
  color: #ffffff;
  text-decoration: none;
}

.mobile-drawer-footer {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 340px;
  margin: 0 auto;
  width: 100%;
}

.btn-whatsapp-drawer {
  background: #25D366;
  color: #ffffff;
  text-decoration: none;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   4. MONUMENTAL HERO SECTION
   -------------------------------------------------------------------------- */
.hero-section {
  position: relative;
  min-height: calc(100vh - 40px);
  display: flex;
  align-items: center;
  padding-top: 120px;
  padding-bottom: 50px;
  z-index: 2;
}

.hero-container {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 56px;
}

.hero-editorial {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-pill-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 16px;
  background: rgba(84, 143, 203, 0.12);
  border: 1px solid rgba(84, 143, 203, 0.28);
  border-radius: var(--radius-full);
  margin-bottom: 24px;
}

.pill-glow-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--c-sky);
  box-shadow: 0 0 10px var(--c-sky);
  animation: pulse-glow 2s infinite ease-in-out;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.pill-text {
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--c-ice);
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 4.8vw, 4.5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.03em;
  margin-bottom: 24px;
}

.hero-description {
  font-size: 1.12rem;
  line-height: 1.65;
  color: var(--text-secondary);
  max-width: 580px;
  margin-bottom: 36px;
}

.hero-cta-cluster {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 48px;
}

.hero-partners-strip {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.partners-lead {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  font-weight: 600;
}

.partner-chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.partner-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-secondary);
}

.chip-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--c-sky);
}

/* Right Interactive Card: Growth Simulator */
.hero-interactive-card {
  position: relative;
  background: linear-gradient(145deg, rgba(19, 29, 52, 0.85) 0%, rgba(11, 16, 31, 0.95) 100%);
  border: 1px solid var(--border-glow);
  border-radius: var(--radius-lg);
  padding: 36px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20px);
}

.interactive-glow-halo {
  position: absolute;
  top: -20%;
  right: -20%;
  width: 250px;
  height: 250px;
  background: radial-gradient(circle, rgba(84, 143, 203, 0.25) 0%, transparent 70%);
  filter: blur(40px);
  pointer-events: none;
}

.interactive-card-inner {
  position: relative;
  z-index: 1;
}

.interactive-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
}

.interactive-eyebrow {
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--c-sky);
  font-weight: 700;
  display: block;
  margin-bottom: 4px;
}

.interactive-title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
  color: #ffffff;
}

.interactive-live-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  color: #34d399;
}

.pulse-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #10b981;
  animation: pulse-glow 1.5s infinite;
}

.simulator-control {
  margin-bottom: 24px;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.control-label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text-secondary);
}

.control-val-badge {
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
  padding: 3px 10px;
  background: rgba(84, 143, 203, 0.16);
  border: 1px solid rgba(84, 143, 203, 0.3);
  border-radius: var(--radius-xs);
}

.custom-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 8px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.1);
  outline: none;
  cursor: pointer;
  transition: background 0.2s;
}

.custom-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-purple), var(--c-sky));
  border: 2px solid #ffffff;
  cursor: pointer;
  box-shadow: 0 0 15px rgba(84, 143, 203, 0.7);
  transition: transform 0.15s var(--ease-spring);
}

.custom-slider::-webkit-slider-thumb:hover {
  transform: scale(1.15);
}

.slider-ticks {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
  font-size: 0.75rem;
  color: var(--text-dim);
  font-weight: 600;
  user-select: none;
}

.slider-ticks span {
  cursor: pointer;
  padding: 2px 4px;
  border-radius: 4px;
  transition: color 0.2s, background 0.2s;
}

.slider-ticks span:hover,
.slider-ticks span.active {
  color: var(--c-sky);
  background: rgba(84, 143, 203, 0.12);
}

/* Simulator Output Tiles */
.simulator-results-matrix {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 24px;
}

.result-tile {
  background: rgba(10, 15, 29, 0.65);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  flex-direction: column;
}

.result-label {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 6px;
}

.result-number {
  font-family: var(--font-display);
  font-size: 1.45rem;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  margin-bottom: 4px;
}

.result-subtext {
  font-size: 0.74rem;
  color: var(--text-dim);
}

.simulator-hint {
  display: block;
  font-size: 0.75rem;
  color: var(--text-muted);
  text-align: center;
  margin-top: 10px;
}

/* --------------------------------------------------------------------------
   5. SERVICES SECTION: THE 6 GROWTH ENGINES (3D TILT CARDS)
   -------------------------------------------------------------------------- */
.section-intro {
  max-width: 720px;
  margin: 0 auto 40px auto;
}

.section-badge {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--c-sky);
  margin-bottom: 12px;
}

.section-heading {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.2vw, 3rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
}

.section-subheading {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.services-matrix {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.service-card {
  position: relative;
  background: var(--bg-glass-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 36px 30px;
  display: flex;
  flex-direction: column;
  transition: transform 0.4s var(--ease-spring), border-color 0.4s, box-shadow 0.4s;
  backdrop-filter: blur(16px);
  overflow: hidden;
}

.service-card:hover {
  transform: translateY(-6px);
  border-color: var(--border-bright);
  box-shadow: 0 20px 45px rgba(84, 143, 203, 0.2);
}

.card-glow-reflection {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, var(--c-plum), var(--c-purple), var(--c-sky));
  opacity: 0.4;
  transition: opacity 0.3s;
}

.service-card:hover .card-glow-reflection {
  opacity: 1;
}

.service-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(95, 61, 131, 0.35), rgba(84, 143, 203, 0.25));
  border: 1px solid rgba(84, 143, 203, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.service-svg {
  width: 26px;
  height: 26px;
  color: #ffffff;
}

.service-num {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--c-sky);
  display: block;
  margin-bottom: 8px;
}

.service-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  margin-bottom: 14px;
  line-height: 1.25;
}

.service-desc {
  font-size: 0.94rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 22px;
  flex-grow: 1;
}

.service-tags {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 16px;
}

.service-tags li {
  font-size: 0.8rem;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 6px;
}

.service-tags li::before {
  content: "→";
  color: var(--c-sky);
  font-weight: bold;
}

/* --------------------------------------------------------------------------
   6. CLIENT VELOCITY MARQUEE
   -------------------------------------------------------------------------- */
.clients-section {
  padding: 44px 0;
  position: relative;
  overflow: hidden;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  background: rgba(7, 10, 18, 0.6);
}

.marquee-caption {
  text-align: center;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 18px;
}

.marquee-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16px;
  mask-image: linear-gradient(90deg, transparent 0%, black 15%, black 85%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 15%, black 85%, transparent 100%);
}

.marquee-track {
  display: flex;
  width: max-content;
  animation: marquee-scroll 40s linear infinite;
}

.marquee-track:hover {
  animation-play-state: paused;
}

.marquee-track.reverse {
  animation: marquee-scroll-reverse 28s linear infinite;
}

.marquee-track.reverse:hover {
  animation-play-state: paused;
}

@keyframes marquee-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@keyframes marquee-scroll-reverse {
  from { transform: translateX(-50%); }
  to { transform: translateX(0); }
}

.marquee-content {
  display: flex;
  align-items: center;
  gap: 36px;
  padding-right: 36px;
}

.client-wordmark {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: -0.02em;
  text-decoration: none;
  cursor: pointer;
  display: inline-block;
  transition: color 0.3s, transform 0.25s, text-shadow 0.3s;
}

.client-wordmark:hover {
  color: #ffffff;
  transform: translateY(-2px);
  text-shadow: 0 0 20px rgba(84, 143, 203, 0.6);
}

.client-dot {
  color: var(--c-purple);
  font-size: 1.2rem;
}

.ticker-pill {
  padding: 6px 18px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* --------------------------------------------------------------------------
   7. RESULTS SECTION & CASE STUDIES
   -------------------------------------------------------------------------- */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 44px;
}

.stat-card {
  background: var(--bg-glass-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 28px 22px;
  text-align: left;
  backdrop-filter: blur(12px);
  transition: transform 0.3s var(--ease-spring), border-color 0.3s;
}

.stat-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-bright);
}

.stat-value {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 3.5vw, 3.2rem);
  font-weight: 800;
  line-height: 1;
