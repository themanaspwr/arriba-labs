  -webkit-text-fill-color: transparent;
  display: inline-block;
  margin-bottom: 8px;
}

.stat-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 6px;
}

.stat-desc {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.5;
}

/* Featured Case Studies */
.case-studies-wrap {
  background: rgba(14, 22, 40, 0.65);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 48px;
