}

.success-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #10b981;
  color: #ffffff;
  font-weight: bold;
  font-size: 1.2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px auto;
}

.form-success-banner h4 {
  font-size: 1.1rem;
  color: #ffffff;
  margin-bottom: 4px;
}

.form-success-banner p {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

