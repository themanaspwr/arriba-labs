/* --------------------------------------------------------------------------
   13. FLOATING WHATSAPP BUTTON
   -------------------------------------------------------------------------- */
.floating-whatsapp-wrap {
  position: fixed;
  bottom: 28px;
  right: 28px;
  z-index: 990;
}

.floating-whatsapp-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #25D366, #128C7E);
  color: #ffffff;
  padding: 12px 20px;
  border-radius: var(--radius-full);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.92rem;
  box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
  transition: transform 0.3s var(--ease-spring), box-shadow 0.3s;
  position: relative;
}

.floating-whatsapp-btn:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 12px 35px rgba(37, 211, 102, 0.6);
}

.whatsapp-btn-pulse {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-full);
  border: 2px solid #25D366;
  opacity: 0.6;
  animation: wa-pulse 2.5s infinite ease-out;
  pointer-events: none;
}

@keyframes wa-pulse {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.3); opacity: 0; }
}

@media (max-width: 1180px) {
  .services-matrix {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* --------------------------------------------------------------------------
   14. COMPREHENSIVE RESPONSIVE BREAKPOINTS
   -------------------------------------------------------------------------- */
@media (max-width: 1024px) {
  .hero-container {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .hero-editorial {
    align-items: center;
    text-align: center;
  }

  .hero-description {
    max-width: 640px;
  }

  .hero-cta-cluster {
    justify-content: center;
  }

  .hero-partners-strip {
    align-items: center;
  }

  .services-matrix {
    grid-template-columns: repeat(2, 1fr);
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .cases-showcase-grid {
    grid-template-columns: 1fr;
  }

  .manifesto-grid {
    grid-template-columns: 1fr;
  }

  .process-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .testimonials-grid {
    grid-template-columns: 1fr;
  }

  .contact-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .footer-top-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 768px) {
  .nav-center-menu,
  .sound-toggle-btn,
  .btn-nav-cta {
    display: none;
  }

  .mobile-menu-btn {
    display: flex;
  }

  .services-matrix {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .contact-card-wrapper {
    padding: 36px 24px;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .footer-top-grid {
    grid-template-columns: 1fr;
  }

  .footer-bottom-bar {
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .whatsapp-btn-text {
    display: none;
  }

  .floating-whatsapp-btn {
    width: 52px;
    height: 52px;
    padding: 0;
    justify-content: center;
    border-radius: 50%;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 2.2rem;
  }

  .hero-cta-cluster {
    flex-direction: column;
    width: 100%;
  }

  .btn-hero {
    width: 100%;
  }

  .simulator-results-matrix {
    grid-template-columns: 1fr;
  }
}
