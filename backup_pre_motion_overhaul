  gap: 16px;
  margin-bottom: 36px;
}

.perk-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--text-secondary);
}

.perk-item strong {
  color: #ffffff;
}

.perk-icon {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(84, 143, 203, 0.2);
