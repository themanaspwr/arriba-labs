  left: 20%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(95, 61, 131, 0.25) 0%, transparent 70%);
  filter: blur(60px);
  pointer-events: none;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  gap: 56px;
  position: relative;
  z-index: 1;
}

.contact-badge {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--c-sky);
  margin-bottom: 12px;
}

.contact-headline {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.2vw, 2.8rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 16px;
}

.contact-subhead {
  font-size: 1.02rem;
  line-height: 1.6;
