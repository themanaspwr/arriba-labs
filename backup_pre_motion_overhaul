}

/* --------------------------------------------------------------------------
   8. WHY ARRIBA: ANTI-AGENCY MANIFESTO
   -------------------------------------------------------------------------- */
.manifesto-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}

.manifesto-card {
